# Пример nginx-конфига для drop.ai (положить в /etc/nginx/sites-available/drop-ai)
# Заменить drop.ai на ваш домен и пути к сертификатам.

server {
    listen 80;
    server_name drop.ai www.drop.ai;
    return 301 https://drop.ai$request_uri;
}

server {
    listen 443 ssl http2;
    server_name drop.ai;

    ssl_certificate     /etc/letsencrypt/live/drop.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drop.ai/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Файлы загрузок и сгенерированных карточек — отдаём напрямую
    client_max_body_size 12M;

    # Безопасные заголовки
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Long-running запросы (генерация AI может занимать до 60 сек)
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
