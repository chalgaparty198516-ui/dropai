# Сгенерируй случайную строку, минимум 32 символа.
# Можно: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Базовый URL приложения (используется в OAuth-редиректах и cookie)
BETTER_AUTH_URL=http://localhost:3010

# ===== Хранилище данных =====
# DEV: оставить пустым — используется локальный SQLite (./dropai.db).
# PROD (Vercel + Neon): подключить Neon из Vercel marketplace, переменная
# DATABASE_URL придёт автоматически из интеграции.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Путь к SQLite-файлу для локальной разработки
# DROPAI_DB_PATH=./dropai.db

# ===== Хранилище файлов (загруженные фото + сгенерированные карточки) =====
# DEV: оставить пустым — пишем в ./public/uploads.
# PROD (Vercel Blob): подключить Blob из Vercel Storage, переменная придёт автоматически.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Google OAuth — получить здесь:
# https://console.cloud.google.com/apis/credentials
# Тип: OAuth 2.0 Client ID, тип приложения: Web application
# Authorized redirect URI: http://localhost:3010/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — для реальной генерации карточек товара через gpt-image-1.
# Получить: https://platform.openai.com/api-keys
# ~$0.05 за карточку. Самое высокое качество, сохраняет товар 1-в-1.
OPENAI_API_KEY=

# Модель OpenAI для генерации (по умолчанию gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Replicate — платный image-to-image через Flux Kontext Pro (~$0.04 за изображение).
# Получить: https://replicate.com/account/api-tokens
# Лучшее соотношение цена/качество для сохранения товара.
REPLICATE_API_TOKEN=
# Модель по умолчанию: black-forest-labs/flux-kontext-pro
# REPLICATE_MODEL=black-forest-labs/flux-kontext-max

# fal.ai — платный быстрый image-to-image через Flux Kontext.
# Получить: https://fal.ai/dashboard/keys
FAL_KEY=
# FAL_MODEL=fal-ai/flux-pro/kontext

# HuggingFace — БЕСПЛАТНЫЙ image-to-image через SDXL Inference API.
# Получить: https://huggingface.co/settings/tokens (тип Read)
# HF_TOKEN=
# HF_IMG2IMG_MODEL=stabilityai/stable-diffusion-xl-refiner-1.0

# Принудительно выбрать конкретного провайдера (override автоматического выбора)
# DROPAI_PROVIDER=replicate

# Google Gemini — БЕСПЛАТНЫЙ image-to-image через Gemini 2.5 Flash Image (Nano Banana).
# Видит ваше фото и сохраняет товар на карточке. Реальный image2image, не text2image.
# Получить: https://aistudio.google.com/apikey (2 минуты, без карты).
# Free tier: ~100 генераций в день. Используется автоматически если нет OPENAI_API_KEY.
GEMINI_API_KEY=

# Модель Gemini для генерации изображений (по умолчанию gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pollinations — бесплатный AI-провайдер (используется автоматически если нет OPENAI_API_KEY).
# Никаких ключей не нужно, но при желании можно прописать токен из https://auth.pollinations.ai
# POLLINATIONS_TOKEN=
# POLLINATIONS_MODEL=flux

# Полностью отключить Pollinations и оставить только demo-режим без AI:
# DROPAI_DISABLE_POLLINATIONS=1

# HuggingFace токен — включает vision-описание загруженного фото перед генерацией
# (Pollinations Flux не видит изображения сам, без описания получится произвольная сцена).
# Бесплатно: https://huggingface.co/settings/tokens — тип Read.
# HF_TOKEN=

# Публичный URL приложения (например https://drop.ai) — используется в Robokassa
# Result URL и для OAuth-редиректов. Бесплатный Pollinations всё равно не умеет
# image-to-image, так что от этого качество AI не зависит.
# PUBLIC_BASE_URL=https://drop.ai

# В production включить, если ваш VPS за корп-прокси с MITM SSL и нужно отключить TLS-валидацию
# исходящих запросов к Pollinations. В dev отключено по умолчанию.
# DROPAI_INSECURE_FETCH=1

# ===== Robokassa =====
# Получить в личном кабинете https://partner.robokassa.ru
# В кабинете указать Result URL: https://<ваш домен>/api/billing/robokassa/result
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# По умолчанию включён тестовый режим (IsTest=1). Для боевых платежей выставить 0.
ROBOKASSA_IS_TEST=1

# ===== Юр. реквизиты для оферты и политики =====
DROPAI_LEGAL_TYPE=Самозанятый (плательщик НПД)
DROPAI_LEGAL_NAME=Иванов Иван Иванович
DROPAI_LEGAL_INN=000000000000
DROPAI_LEGAL_CITY=Москва
DROPAI_LEGAL_EMAIL=hello@drop.ai
DROPAI_LEGAL_WEBSITE=https://drop.ai
